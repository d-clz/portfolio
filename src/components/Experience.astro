---
const {title, time, details} = Astro.props;
---

<div style="margin-top: 20px; white-space: pre-line">
    <div style="
        font-weight: bold;
        font-style: italic;
        font-size: 16px;
        text-transform: uppercase;
    ">{title}</div>
    <div style="
        font-weight: lighter;
        font-size: 15px;
        color: #E5C07B;
        margin-bottom: 5px;
    ">{time}</div>
    <div style="
        font-weight: lighter;
        font-size: 15px
    ">{details}</div>
</div>