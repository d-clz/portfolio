---
//src/components/Card.astro
const { name, position, aboutMe, cvLink, profileImage } = Astro.props;

import { Image } from 'astro:assets';
import WindowChrome from './WindowChrome.astro';
import '../styles/card.css';
---

<div class="container">
    <div class="card-window">
        <WindowChrome>
            <span slot="title" class="win-identity">
                <span class="win-name">{name}</span>
                <span class="win-sep" aria-hidden="true">—</span>
                <span class="win-role">{position}</span>
            </span>
        </WindowChrome>

        <div class="card-container">
            <div class="descripcion">
                <p>{aboutMe}</p>
                <a class="launch-btn" href={cvLink}>
                    <span class="chevron" aria-hidden="true">❯</span>
                    <span class="label">more information</span>
                </a>
            </div>
            <div class="image">
                <div class="photo-frame">
                    <Image src={profileImage} alt="" width={250} height={250} densities={[1, 2]} />
                </div>
                <span class="photo-caption">~/profile.jpg</span>
            </div>
        </div>
    </div>
</div>
