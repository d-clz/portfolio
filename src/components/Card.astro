---
//src/components/Card.astro
const {name, position, aboutMe, linkedin, blog, github, cvLink, profileImage } = Astro.props;

import '../styles/card.css';
---

<div class="container">
    <div class="card-container">
        <div class="descripcion">
            <div class="tilte">
                <h1>{name}</h1>
                <h2>{position}</h2>
            </div>
            <p>{aboutMe}</p>
            <div class="icons">
                <a href={linkedin} class="hover-text" target="_blank">
                    <i class="bi bi-linkedin"></i>
                    <span class="tooltip-text" id="fade">
                        LinkedIn
                    </span>
                </a>
                <a href={github} class="hover-text" target="_blank">
                    <i class="bi bi-github"></i>
                    <span class="tooltip-text" id="fade">
                        GitHub
                    </span>
                </a>
                <a href={blog} class="hover-text" target="_blank">
                    <i class="bi bi-globe2"></i>
                    <span class="tooltip-text" id="fade">
                        Blog
                    </span>
                </a>
                <a href={cvLink} class="hover-text">
                    <i class="bi bi-caret-right-fill"></i>
                    <span class="tooltip-text" id="fade">
                        Resume
                    </span>
                </a>
            </div>
        </div>
        <div class="image">
            <img src={profileImage} alt="">
        </div>
    </div>
</div>