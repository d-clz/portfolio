---
// src/pages/index.astro

import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import LiquidBackground from "../components/LiquidBackground.astro";
import profilePic from "../assets/profile-pic.jpg";
import { BIO, PAGES, PROFILE, ROUTES } from "../data/terminal-data";
import "../styles/background.css";
---

<!-- All content comes from src/data/terminal-data.ts — edit it there. -->
<BaseLayout title={PAGES.card.title} description={PAGES.card.description}>
	<LiquidBackground />
	<Card
	  name={PROFILE.name}
	  position={PROFILE.role}
	  aboutMe={BIO}
	  cvLink={ROUTES.details}
	  profileImage={profilePic}
	/>
</BaseLayout>

