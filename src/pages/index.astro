   -->

<!-- You can replace the card's data with your own here. -->
<BaseLayout title="Information Card" description="Meta description. Here goes your page description. Provide a clear and concise summary of the content.">
	<Card
	  name="Duong Hoang"
	  position="DevOps / SRE"
	  aboutMe={`Howdy! I'm Duong, a senior DevOps Engineer.\n\nWith more than 5 years of experience, I specialize in designing, implementing, and maintaining scalable, secure, and efficient infrastructure.\nI thrive on automating pipelines/tasks, optimizing system performance and ensuring high-availability.\n\nWith strong self-researching & problem-solving skills, I'm excited to collaborate with visionary teams to deliver outstanding results.`}
	  linkedin="https://www.linkedin.com/in/dclz"
	  github="https://github.com/d-clz"
	  blog="https://d-clz.github.io"
	  cvLink="/resume"
	  profileImage="/images/profile-pic.jpg"
	/>
</BaseLayout>

