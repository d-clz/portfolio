---
// src/pages/index.astro

import BaseLayout from "../layouts/BaseLayout.astro";
import Contacts from "../components/Contacts.astro";
import '../styles/resume.css'
import Education from "../components/Education.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
---


<BaseLayout title="Resume" description="Duong Hoang's online Resume">
    <div class="container">
        <div class="resume">
            <Contacts
                    name="Duong Hoang"
                    title="DevOps Engineer / Site Reliable Engineer / System Architechure"
                    email="duong.ht0831@gmail.com"
                    phoneNo="+84 988 069 638"
                    linkedin="linkedin.com/in/dclz"
                    location="Hanoi, Vietnam"
            />
            <div class="profile">
                <div style="
                    display: inline-block;
                    color: #61AFEF;
                ">
                    <i class="bi bi-briefcase-fill"></i>
                    <span style="
                        font-weight: bold;
                        font-size: 18px;
                        text-transform: uppercase;
                    ">Education & Experiences</span>
                </div>
                <hr>
                <div class="profile-body">
                    <div style="width: 50%; margin: 0 30px">
                        <Education
                                title="Physics Majoring - BOK27B"
                                details="High School for Gifted Student, Hanoi University of Sciences"
                                time="2012 - 2015"
                        />
                        <Education
                                title="Mechatronic System / Bachelor Degree"
                                details="University of Engineering and Technology, VNU-H"
                                time="2015 - 2019"
                        />
                        <Education
                                title="Redhat Openshift Administration II:\nOperating a Production Kubernetes Cluster"
                                details="Redhat Training and Certification"
                                time="Jan, 2024"
                        />

                    </div>
                    <div style="width: 50%; margin: 0 30px">
                        <Experience
                                title="Maintain Homelab Virtual Environment"
                                time="Since 2017"
                                details="A HomeLab Server which provided WireGuard VPN, Pi-holes (as DNS Ads-Blocker), NextCloud, Game Servers & Discord bot hosting."
                        />
                        <Experience
                                title="DevOps Engineer at Abivin Vietnam"
                                time="2019 - 2022"
                                details="Design and Maintain Cloud Architechture/Infrastructure. Develop and Deploy CI/CD Pipelines with Jenkins, Docker Registry, Kubernetes and Git."
                        />
                        <Experience
                                title="Senior DevOps Engineer\nat Tien Phong Join Stock Commercial Bank"
                                time="Since 2022"
                                details="Design, Deploy and Operate On-premises Infrastructures. Optimize Performance & Ensure Scalability / High-Availability for Digital Banking Platform."
                        />
                    </div>
                </div>
            </div>
            <div class="profile">
                <div style="
                    display: inline-block;
                    color: #61AFEF;
                ">
                    <i class="bi bi-clipboard-check-fill"></i>
                    <span style="
                        font-weight: bold;
                        font-size: 18px;
                        text-transform: uppercase;
                    ">Skills & Capacities</span>
                </div>
                <hr>
                <div class="content-container">
                    <div class="list-container">
                        <Skills/>
                        <ul>
                            <li>
                                <strong>Operating System: </strong>More than 7 years of experience managng & operating linux and unix-like system. Specialize in containerize engine with hand-on expertise in lxc, lxd, dockerd, containerd, cri-o, podman, and more.
                            </li>
                            <li>
                                <strong>Scripting Language: </strong>Proficient in Shell, Python, NodeJS and GoLang with extensive experience in automation and scripting to streamline processes and improve efficiency.
                            </li>
                            <li>
                                <strong>Technology & Architecture: </strong>Experienced in designing and implementing complex high-availability (HA) systems, incorporating MongoDB, PostgresSQL, Redis, RabbitMQ, Kafka, Kubernetes Cluster, etc. in both Cloud & On-Premises environment.
                            </li>
                            <li>
                                <strong>Product Management Knowledge: </strong>Strong understanding of APIs, network protocols, and coding patterns. Extensive participation in software product development across multiple levels, including B2B and B2C environments. And proven track record of managing user bases ranging from approximately 20,000 to more than 10 million users.
                            </li>
                            <li>
                                <strong>Soft Skills: </strong>Fluent in reading and comprehending technical documents in English, with strong communication skills. Possess excellent self-research abilities and independent problem-solving skills.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="profile">
                <div class="list-container" style="
                    display: inline-block;
                    color: #61AFEF;
                    margin-bottom: 8px;
                ">
                    <i class="bi bi-clipboard-check-fill"></i>
                    <span style="
                        font-weight: bold;
                        font-size: 18px;
                        text-transform: uppercase;
                    ">Interests</span>
                </div>
                <hr>
                <div style="display: inline-grid;grid-template-columns: repeat(3, 1fr);gap: 20px;grid-auto-rows: minmax(100px, auto); margin-top: 20px; width: 100%">
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-row: 1">
                        <i class="bi bi-controller" style="font-size: 50px"></i>
                        <p>Video Games</p>
                    </div>
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-column: 2/3;grid-row: 1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-luggage-fill" viewBox="0 0 16 16">
                            <path d="M2 1.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V5h.5A1.5 1.5 0 0 1 8 6.5V7H7v-.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5H4v1H2.5v.25a.75.75 0 0 1-1.5 0v-.335A1.5 1.5 0 0 1 0 13.5v-7A1.5 1.5 0 0 1 1.5 5H2zM3 5h2V2H3z"/>
                            <path d="M2.5 7a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0v-5a.5.5 0 0 1 .5-.5m10 1v-.5A1.5 1.5 0 0 0 11 6h-1a1.5 1.5 0 0 0-1.5 1.5V8H8v8h5V8zM10 7h1a.5.5 0 0 1 .5.5V8h-2v-.5A.5.5 0 0 1 10 7M5 9.5A1.5 1.5 0 0 1 6.5 8H7v8h-.5A1.5 1.5 0 0 1 5 14.5zm9 6.5V8h.5A1.5 1.5 0 0 1 16 9.5v5a1.5 1.5 0 0 1-1.5 1.5z"/>
                        </svg>
                        <p style="margin-top: 12px">Travelling</p>
                    </div>
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-column: 3/3;grid-row: 1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-person-arms-up" viewBox="0 0 16 16">
                            <path d="M8 3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3"/>
                            <path d="m5.93 6.704-.846 8.451a.768.768 0 0 0 1.523.203l.81-4.865a.59.59 0 0 1 1.165 0l.81 4.865a.768.768 0 0 0 1.523-.203l-.845-8.451A1.5 1.5 0 0 1 10.5 5.5L13 2.284a.796.796 0 0 0-1.239-.998L9.634 3.84a.7.7 0 0 1-.33.235c-.23.074-.665.176-1.304.176-.64 0-1.074-.102-1.305-.176a.7.7 0 0 1-.329-.235L4.239 1.286a.796.796 0 0 0-1.24.998l2.5 3.216c.317.316.475.758.43 1.204Z"/>
                        </svg>
                        <p style="margin-top: 12px">Sports</p>
                    </div>
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-row: 2">
                        <i class="bi bi-tools" style="font-size: 50px"></i>
                        <p>Crafting</p>
                    </div>
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-column: 2/3;grid-row: 2">
                        <i class="bi bi-keyboard" style="font-size: 50px"></i>
                        <p>Custom Keyboards</p>
                    </div>
                    <div style="display: flex;flex-direction: column;justify-content: center; align-items: center;grid-column: 3/3;grid-row: 2">
                        <i class="bi bi-sunglasses" style="font-size: 50px"></i>
                        <p>°</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
