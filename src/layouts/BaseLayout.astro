---
//src/layouts/BaseLayout.astro
const { title = 'Profile Card', description } = Astro.props;

import '../styles/palette.css';
import '../styles/global.css';
---
<!-- Here you can change everything related to the head, favicon, icons, and fonts. -->

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <!-- Applied before paint so there's no flash of the wrong theme. Reads the
         same 'site-theme' key as the blog (d-clz.github.io) — same origin, so
         the preference is shared across both sites. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('site-theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="color-scheme" content="dark light">
    <!-- FAVICON -->
    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.ico`} type="image/x-icon">
    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400&display=swap" rel="stylesheet">
    <!-- CDN ICON BOOTSTRAP 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>